# Mirall release configuration
#
# Copy this file to .env (which is gitignored) and fill in real values.
# Used by scripts/release-pear.sh and any other tooling that needs to talk
# to the seed VM or know about the Pear channel keys.

# Hetzner seed VM IP address. The seed VM holds the canonical production
# corestore and runs `pear seed production` continuously.
MIRALL_SEED_IP=

# Dev channel z32 key (must match the literal in appling/app.dev.cjs).
# Used by scripts/release-pear.sh to verify there's no drift between the
# checked-in appling and what we're about to dump+rsync to the seed VM.
MIRALL_DEV_KEY=

# Production channel z32 key (must match the literal in appling/app.cjs).
# Verified at release time so you can't accidentally ship an MSIX whose
# embedded key doesn't point at the production channel you're releasing to.
MIRALL_PROD_KEY=

# Optional: staging channel z32 key (must match appling/app.staging.cjs).
# Only checked if set — leave blank if you don't have a staging deploy yet.
MIRALL_STAGING_KEY=

# Optional flags for scripts/release-pear.sh
# SKIP_PUSH=1     skip `git push --tags` (commit + tag locally only)
# SKIP_REMOTE=1   skip the seed-host promotion (stage dev locally only)
