{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/preload/preload.js",
    "src/worker/main.js",
    "forge.config.js",
    "scripts/**/*.{js,mjs}"
  ],
  "project": [
    "src/**/*.{js,ts,tsx}"
  ],
  "ignore": [
    "src/shared/transfer/backends/overlay/vendor/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "dependencies": "off",
    "devDependencies": "off",
    "binaries": "off",
    "unlisted": "off"
  },
  "tags": [
    "-internal"
  ]
}
