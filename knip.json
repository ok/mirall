{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/preload/preload.js",
    "src/worker/main.js",
    "forge.config.js",
    "scripts/**/*.{js,mjs}",
    "test/**/*.test.js",
    "test/**/run*.mjs",
    "test/helpers/**/*.{js,mjs}",
    "test/frontend-layout/**/*.{js,mjs,ts,tsx}"
  ],
  "project": [
    "src/**/*.{js,ts,tsx}"
  ],
  "ignore": [
    "src/**/*.d.ts",
    "src/shared/transfer/backends/overlay/vendor/**"
  ],
  "rules": {
    "dependencies": "off",
    "devDependencies": "off",
    "binaries": "off",
    "unlisted": "off"
  }
}
