{
  "name": "mirall",
  "productName": "Mirall",
  "version": "1.10.0",
  "description": "Secure large file transfer. No cloud. No accounts.",
  "license": "AGPL-3.0-or-later",
  "author": "Oliver Kohl",
  "type": "commonjs",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/.bin/bare';try{if(!fs.existsSync(p))fs.symlinkSync('../bare-runtime/bin/bare',p)}catch{}\"",
    "build:js": "esbuild src/renderer/main.tsx --bundle --format=esm --target=es2022 --jsx=automatic --outfile=assets/dist/main.js --minify --define:__DEV__=false --sourcemap --sources-content=false --loader:.png=file --loader:.jpg=file --loader:.svg=file",
    "build:css": "npx @tailwindcss/cli -i src/renderer/styles/tailwind.css -o assets/dist/app.css --minify",
    "build:clean": "node -e \"require('fs').rmSync('assets/dist',{recursive:true,force:true})\"",
    "lint": "eslint src",
    "lint:ci": "eslint src --max-warnings 28 && bash scripts/check-comment-hygiene.sh --strict && bash scripts/check-test-timing.sh && bash scripts/check-release-mime.sh",
    "knip": "knip",
    "build": "npm run build:clean && npm run lint && tsc --noEmit && npm run build:js && npm run build:css",
    "start": "npm run build && electron-forge start -- --no-updates",
    "start:dev": "PEAR_DEV_SERVER_URL=http://localhost:5173/index.html electron-forge start -- --no-updates",
    "dev": "concurrently \"npm:dev:js\" \"npm:dev:css\" \"npx serve -l 5173 assets\" \"npm run start:dev\"",
    "dev:js": "esbuild src/renderer/main.tsx --bundle --format=esm --target=es2022 --jsx=automatic --outfile=assets/dist/main.js --define:__DEV__=true --sourcemap --watch --loader:.png=file --loader:.jpg=file --loader:.svg=file",
    "dev:css": "npx @tailwindcss/cli -i src/renderer/styles/tailwind.css -o assets/dist/app.css --watch",
    "package": "npm run build && electron-forge package",
    "make:darwin": "npm run build && electron-forge make --platform=darwin",
    "make:win32": "npm run build && electron-forge make --platform=win32",
    "make:linux": "npm run build && electron-forge package --platform=linux && bash scripts/build-app-image.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:bare",
    "test:node": "npm run test:node:core && npm run test:flow",
    "test:node:core": "brittle-node \"test/unit/*.test.js\" \"test/raw/*.test.js\"",
    "test:flow": "brittle-node \"test/flow/*.test.js\"",
    "test:bare": "brittle-bare -j 4 \"test/integration/*.test.js\"",
    "test:unit": "brittle-node \"test/unit/*.test.js\"",
    "test:fe": "node test/frontend/run.mjs",
    "test:layout": "node test/frontend-layout/run.mjs",
    "test:layout:members": "node test/frontend-layout/run-members.mjs",
    "test:layout:approval": "node test/frontend-layout/run-approval.mjs",
    "test:layout:dropoverlay": "node test/frontend-layout/run-dropoverlay.mjs",
    "test:layout:sharecard": "node test/frontend-layout/run-sharecard.mjs",
    "test:layout:progress": "node test/frontend-layout/run-progress.mjs",
    "test:layout:peerdownload": "node test/frontend-layout/run-peerdownload.mjs",
    "test:layout:filecard": "node test/frontend-layout/run-filecard.mjs",
    "test:layout:modaltitle": "node test/frontend-layout/run-modaltitle.mjs",
    "test:layout:logohover": "node test/frontend-layout/run-logohover.mjs",
    "test:layout:mirrorers": "node test/frontend-layout/run-mirrorers.mjs",
    "test:layout:indexing": "node test/frontend-layout/run-indexing.mjs",
    "test:layout:memo": "node test/frontend-layout/run-memo.mjs",
    "test:layout:spaceoverflow": "node test/frontend-layout/run-spaceoverflow.mjs",
    "test:layout:stickyheader": "node test/frontend-layout/run-stickyheader.mjs",
    "test:layout:focusring": "node test/frontend-layout/run-focusring.mjs",
    "test:layout:truncation": "node test/frontend-layout/run-truncation.mjs"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-msix": "^7.11.2",
    "@eslint/js": "^9.39.5",
    "@react-stately/collections": "^3.13.1",
    "@react-stately/menu": "^3.10.1",
    "@react-stately/tree": "^3.10.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "app-builder-lib": "^26.15.3",
    "bare-runtime": "^1.31.0",
    "brittle": "^4.1.0",
    "concurrently": "^10.0.5",
    "electron": "^42.10.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.1",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "hyperdht": "~6.32.0",
    "i18next": "^26.4.0",
    "knip": "^6.33.0",
    "marked": "^18.0.11",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-fs": "^4.8.1",
    "bare-https": "^3.0.0",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-subprocess": "^6.1.0",
    "blind-relay": "^1.6.1",
    "chokidar": "^5.0.0",
    "compact-encoding": "^3.3.2",
    "corestore": "^7.12.2",
    "debounceify": "^1.1.0",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.35.2",
    "hypercore-crypto": "^3.7.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdrive": "13.3.3",
    "hyperswarm": "^4.17.0",
    "msix-manager": "^0.2.5",
    "paparam": "^1.13.0",
    "pear-runtime": "1.3.1",
    "ready-resource": "^1.2.0",
    "sodium-native": "^5.1.0",
    "sodium-universal": "^5.0.1",
    "which-runtime": "^1.4.0"
  },
  "overrides": {
    "hyperdht": "~6.32.0"
  }
}
